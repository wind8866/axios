{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Axios: Debug Unit Tests",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--inspect-brk"],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "--project", "unit"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Axios: Debug Current Test File",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--inspect-brk"],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "--project", "unit", "${file}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Axios: Debug GET Flow (http adapter)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--inspect-brk"],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": [
        "run",
        "--project",
        "unit",
        "tests/unit/adapters/http.test.js",
        "-t",
        "should support IPv4 literal strings"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Axios: Debug Browser Tests (Chromium)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--inspect-brk"],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "--project", "browser"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Axios: Debug Current Browser Test File",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--inspect-brk"],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "--project", "browser", "${file}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Axios: Debug Current Browser Test by Name",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--inspect-brk"],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": [
        "run",
        "--project",
        "browser",
        "${file}",
        "-t",
        "${input:vitestBrowserTestName}"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Axios: Debug Current Browser Test File (DevTools)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--inspect-brk"],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["--project", "browser-debug", "${file}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Axios: Step-Debug Browser Test (jsdom)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--inspect-brk"],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "--project", "unit-browser", "${file}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Axios: Step-Debug Browser Test by Name (jsdom)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--inspect-brk"],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": [
        "run",
        "--project",
        "unit-browser",
        "${file}",
        "-t",
        "${input:vitestBrowserTestName}"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Axios: Run Examples Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "examples"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Axios: Run Sandbox Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "inputs": [
    {
      "id": "vitestBrowserTestName",
      "type": "promptString",
      "description": "Vitest test name pattern for -t (example: should support basic auth)",
      "default": "should support"
    }
  ]
}
